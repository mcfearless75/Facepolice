---
import Layout from '@/layouts/Layout.astro';
import { site } from '@/data/site';
import { breadcrumbSchema } from '@/data/schema';

const mapQuery = encodeURIComponent(`${site.addressLocality}, ${site.addressRegion}, UK`);
---

<Layout
  title="Contact & Book a Consultation | Face Crease Police® Hoylake"
  description="Get in touch with Face Crease Police in Hoylake, Wirral to book a consultation with Advanced Nurse Practitioner Jo."
  path="/contact/"
  schema={[breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact/' }])]}
>
  <section class="mx-auto max-w-7xl px-5 py-16 sm:px-8 sm:py-24">
    <div class="grid gap-12 lg:grid-cols-2">
      <div>
        <span class="text-xs font-semibold uppercase tracking-[0.14em] text-gold-600">Get in touch</span>
        <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight text-ink-900 sm:text-5xl">Book a consultation</h1>
        <p class="mt-5 text-lg leading-relaxed text-ink-900/70">
          Every new client starts with a consultation, not a treatment slot. Send a few details below and
          Jo will reply personally to arrange a time.
        </p>

        <dl class="mt-10 space-y-6">
          <div>
            <dt class="text-xs font-semibold uppercase tracking-[0.1em] text-ink-900/50">Location</dt>
            <dd class="mt-1 font-display text-lg font-semibold text-ink-900">{site.addressLocality}, {site.addressRegion}</dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-[0.1em] text-ink-900/50">Email</dt>
            <dd class="mt-1"><a href={`mailto:${site.email}`} class="font-display text-lg font-semibold text-ink-900 hover:text-gold-600">{site.email}</a></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-[0.1em] text-ink-900/50">Follow along</dt>
            <dd class="mt-2 flex gap-3">
              {site.social.facebook && (
                <a href={site.social.facebook} target="_blank" rel="noopener noreferrer" class="rounded-full border border-ink-900/15 px-4 py-2 text-sm font-medium hover:border-ink-900/40">Facebook</a>
              )}
              {site.social.tiktok && (
                <a href={site.social.tiktok} target="_blank" rel="noopener noreferrer" class="rounded-full border border-ink-900/15 px-4 py-2 text-sm font-medium hover:border-ink-900/40">TikTok</a>
              )}
            </dd>
          </div>
        </dl>

        <div class="mt-10 aspect-video w-full overflow-hidden rounded-2xl border border-ink-900/10">
          <iframe
            title="Map showing Hoylake, Wirral"
            class="h-full w-full"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}
          ></iframe>
        </div>
      </div>

      <div class="rounded-3xl border border-ink-900/10 bg-white p-7 shadow-soft sm:p-9">
        <h2 class="font-display text-xl font-semibold text-ink-900">Enquiry form</h2>
        <p class="mt-2 text-sm text-ink-900/60">This opens your email client, addressed directly to the clinic.</p>
        <form action={`mailto:${site.email}`} method="get" enctype="text/plain" class="mt-6 space-y-5">
          <div>
            <label for="name" class="text-sm font-semibold text-ink-900">Name</label>
            <input id="name" name="subject" required placeholder="Your name" class="mt-2 w-full rounded-xl border border-ink-900/15 px-4 py-3 text-sm focus:border-ink-900 focus:outline-none" />
          </div>
          <div>
            <label for="email" class="text-sm font-semibold text-ink-900">Your email</label>
            <input id="email" type="email" name="body" required placeholder="you@email.com" class="mt-2 w-full rounded-xl border border-ink-900/15 px-4 py-3 text-sm focus:border-ink-900 focus:outline-none" />
          </div>
          <div>
            <label for="message" class="text-sm font-semibold text-ink-900">What are you interested in?</label>
            <textarea id="message" name="body" rows="4" placeholder="Tell us a little about what you'd like to discuss" class="mt-2 w-full rounded-xl border border-ink-900/15 px-4 py-3 text-sm focus:border-ink-900 focus:outline-none"></textarea>
          </div>
          <button type="submit" class="w-full rounded-full bg-ink-900 px-6 py-3.5 text-sm font-semibold text-porcelain-50 transition hover:bg-ink-800">
            Send Enquiry
          </button>
          <p class="text-center text-xs text-ink-900/50">
            Prefer email directly? Write to <a href={`mailto:${site.email}`} class="font-semibold text-ink-900 underline">{site.email}</a>.
          </p>
        </form>
      </div>
    </div>
  </section>
</Layout>
