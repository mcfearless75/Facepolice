---
import Layout from '@/layouts/Layout.astro';
import CtaBand from '@/components/CtaBand.astro';
import { goals } from '@/data/goals';
import { breadcrumbSchema } from '@/data/schema';
---

<Layout
  title="Treatments by Goal | Face Crease Police® Hoylake"
  description="Not sure where to start? Explore Face Crease Police treatments grouped by goal — Refresh, Refine, Relax and Renew — and find the right plan for your skin."
  path="/goals/"
  schema={[breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Treatments by Goal', path: '/goals/' }])]}
>
  <section class="mx-auto max-w-7xl px-5 py-16 sm:px-8 sm:py-24">
    <div class="max-w-2xl">
      <span class="text-xs font-semibold uppercase tracking-[0.14em] text-gold-600">Not sure where to start?</span>
      <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight text-ink-900 sm:text-5xl">Treatments, grouped by goal.</h1>
      <p class="mt-5 text-lg leading-relaxed text-ink-900/65">
        Four outcome-led categories to help you find the right starting point — your exact plan is always
        confirmed at consultation.
      </p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {goals.map((goal) => (
        <a href={`/goals/${goal.slug}/`} class="group rounded-3xl bg-ink-900 p-8 text-porcelain-50 transition hover:bg-ink-800">
          <h2 class="font-display text-3xl font-semibold">{goal.name}</h2>
          <p class="mt-2 font-medium text-gold-400">{goal.strapline}</p>
          <p class="mt-4 text-sm leading-relaxed text-porcelain-100/70">{goal.description}</p>
          <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold">
            Explore {goal.name}
            <svg class="h-3.5 w-3.5 transition group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>
      ))}
    </div>
  </section>

  <CtaBand />
</Layout>
