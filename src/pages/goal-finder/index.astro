---
import Layout from '@/layouts/Layout.astro';
import GoalWizard from '@/components/GoalWizard.astro';
import CtaBand from '@/components/CtaBand.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import { breadcrumbSchema } from '@/data/schema';

const wizardFaqs = [
  {
    q: 'Is this a diagnosis or a prescription?',
    a: 'No. The Goal Finder is a starting point to help you explore which treatment category fits your goals — it is not a clinical assessment. Every treatment plan, including whether a prescription-only medicine is appropriate, is only ever confirmed by Jo at a face-to-face consultation.',
  },
  {
    q: 'How long does it take?',
    a: 'Four quick questions — most people finish in under a minute.',
  },
];
---

<Layout
  title="Goal Finder | Which Treatment Category Is Right for You? | Maison Aurelia"
  description="Answer four quick questions to find which treatment category — Refresh, Refine, Relax or Renew — best fits your goals. Not a diagnosis; your plan is always confirmed at consultation."
  path="/goal-finder/"
  schema={[breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Goal Finder', path: '/goal-finder/' }])]}
>
  <section class="mx-auto max-w-3xl px-5 py-16 text-center sm:px-8 sm:py-24" data-reveal>
    <span class="text-xs font-semibold uppercase tracking-[0.14em] text-aurelia-600">Not sure where to start?</span>
    <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight text-emerald-900 sm:text-5xl">Find your goal in four questions.</h1>
    <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-emerald-900/65">
      Answer a few quick questions about what you'd like to change and we'll point you to the right treatment
      category to explore — Refresh, Refine, Relax or Renew. It's a starting point, not a diagnosis; your
      actual plan is always confirmed at a consultation with Jo.
    </p>
  </section>

  <section class="px-5 pb-20 sm:px-8 sm:pb-28" data-reveal>
    <GoalWizard />
  </section>

  <section class="mx-auto max-w-3xl px-5 pb-20 sm:px-8" data-reveal>
    <FaqAccordion faqs={wizardFaqs} />
  </section>

  <CtaBand />
</Layout>
