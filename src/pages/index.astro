---
import Layout from '@/layouts/Layout.astro';
import TreatmentCard from '@/components/TreatmentCard.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import CtaBand from '@/components/CtaBand.astro';
import { treatments } from '@/data/treatments';
import { goals } from '@/data/goals';
import { generalFaqs } from '@/data/faqs';
import { site } from '@/data/site';
import { faqSchema } from '@/data/schema';

const featured = generalFaqs.slice(0, 4);
---

<Layout
  title="Face Crease Police® | Aesthetics Clinic in Hoylake, Wirral"
  description="Medically-led facial aesthetics in Hoylake, Wirral. Dermal fillers, skin boosters, polynucleotides, biostimulators, anti-wrinkle treatment and fat dissolving — assessed and delivered by an Advanced Nurse Practitioner."
  path="/"
  schema={[faqSchema(featured)]}
>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-porcelain-50">
    <div class="absolute inset-0 bg-grain"></div>
    <div class="relative mx-auto grid max-w-7xl gap-12 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:py-28">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full border border-gold-500/30 bg-gold-400/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.14em] text-gold-600">
          Prescriber-led &middot; Hoylake, Wirral
        </p>
        <h1 class="mt-5 font-display text-4xl font-semibold leading-[1.08] tracking-tight text-ink-900 sm:text-5xl lg:text-6xl">
          Facial rejuvenation, judged the way a clinician judges it.
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-900/70">
          {site.name} is an aesthetics clinic run by {site.practitioner.name}, an {site.practitioner.role}.
          Every treatment plan starts with an honest clinical assessment — not a sales script.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a
            href="/contact/"
            class="inline-flex items-center justify-center rounded-full bg-ink-900 px-7 py-3.5 text-sm font-semibold text-porcelain-50 shadow-soft transition hover:bg-ink-800"
          >
            Book a Consultation
          </a>
          <a
            href="/treatments/"
            class="inline-flex items-center justify-center rounded-full border border-ink-900/15 px-7 py-3.5 text-sm font-semibold text-ink-900 transition hover:border-ink-900/40"
          >
            Explore Treatments
          </a>
        </div>
        <dl class="mt-12 grid grid-cols-3 gap-6 border-t border-ink-900/10 pt-8">
          <div>
            <dt class="text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-900/50">Led by</dt>
            <dd class="mt-1 font-display text-lg font-semibold text-ink-900">Advanced Nurse Practitioner</dd>
          </div>
          <div>
            <dt class="text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-900/50">Approach</dt>
            <dd class="mt-1 font-display text-lg font-semibold text-ink-900">Consultation-first</dd>
          </div>
          <div>
            <dt class="text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-900/50">Based in</dt>
            <dd class="mt-1 font-display text-lg font-semibold text-ink-900">Hoylake, Wirral</dd>
          </div>
        </dl>
      </div>

      <div class="relative">
        <div class="aspect-[4/5] w-full overflow-hidden rounded-[2rem] bg-gradient-to-br from-ink-900 via-ink-800 to-rose-500/40 shadow-soft">
          <div class="flex h-full w-full items-end p-8">
            <div class="rounded-2xl bg-white/10 p-5 backdrop-blur-sm">
              <p class="font-display text-lg font-semibold text-porcelain-50">"Assessment before treatment. Always."</p>
              <p class="mt-1 text-sm text-porcelain-100/70">— {site.practitioner.name}, {site.practitioner.role}</p>
            </div>
          </div>
        </div>
        <div class="absolute -left-6 -top-6 hidden rounded-2xl border border-ink-900/10 bg-white p-4 shadow-soft sm:block">
          <p class="text-2xl font-semibold text-ink-900">8</p>
          <p class="text-xs text-ink-900/60">treatments offered</p>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST STRIP -->
  <section class="border-y border-ink-900/10 bg-white">
    <div class="mx-auto grid max-w-7xl grid-cols-2 gap-6 px-5 py-10 sm:px-8 md:grid-cols-4">
      {[
        ['NMC Registered', 'Regulated nurse prescriber'],
        ['Consultation-First', 'No treatment without assessment'],
        ['No Hard Sell', 'Honest, conservative advice'],
        ['Clear Aftercare', 'Written guidance, every time'],
      ].map(([title, desc]) => (
        <div>
          <p class="font-display text-base font-semibold text-ink-900">{title}</p>
          <p class="mt-1 text-sm text-ink-900/60">{desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- TREATMENTS BY GOAL -->
  <section class="mx-auto max-w-7xl px-5 py-20 sm:px-8">
    <div class="max-w-2xl">
      <span class="text-xs font-semibold uppercase tracking-[0.14em] text-gold-600">Where to start</span>
      <h2 class="mt-3 font-display text-3xl font-semibold text-ink-900 sm:text-4xl">Start with your goal, not a treatment name.</h2>
      <p class="mt-4 text-base leading-relaxed text-ink-900/65">
        Most clients don't arrive knowing which treatment they need — they know how they want to look and feel.
        These four goals group our treatments by outcome.
      </p>
    </div>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {goals.map((goal) => (
        <a href={`/goals/${goal.slug}/`} class="group flex flex-col justify-between rounded-2xl bg-ink-900 p-6 text-porcelain-50 transition hover:bg-ink-800">
          <div>
            <h3 class="font-display text-xl font-semibold">{goal.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-porcelain-100/70">{goal.strapline}</p>
          </div>
          <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-gold-400">
            View treatments
            <svg class="h-3.5 w-3.5 transition group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- ALL TREATMENTS -->
  <section class="bg-porcelain-100/60 py-20">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-2xl">
          <span class="text-xs font-semibold uppercase tracking-[0.14em] text-gold-600">Full menu</span>
          <h2 class="mt-3 font-display text-3xl font-semibold text-ink-900 sm:text-4xl">Every treatment, one prescriber.</h2>
        </div>
        <a href="/treatments/" class="text-sm font-semibold text-ink-900 hover:text-gold-600">View all treatments &rarr;</a>
      </div>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {treatments.map((t) => <TreatmentCard treatment={t} />)}
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="mx-auto max-w-7xl px-5 py-20 sm:px-8">
    <div class="max-w-2xl">
      <span class="text-xs font-semibold uppercase tracking-[0.14em] text-gold-600">How it works</span>
      <h2 class="mt-3 font-display text-3xl font-semibold text-ink-900 sm:text-4xl">Three steps. No pressure.</h2>
    </div>
    <ol class="mt-10 grid gap-8 sm:grid-cols-3">
      {[
        ['01', 'Consultation', 'A full assessment of your skin, goals and medical history with Jo — before anything is agreed or prescribed.'],
        ['02', 'Tailored plan', 'A conservative, realistic treatment plan built around your face, not a fixed package or upsell.'],
        ['03', 'Treatment & aftercare', 'Precise treatment followed by written aftercare and a direct line back to Jo for any questions.'],
      ].map(([num, title, desc]) => (
        <li>
          <span class="font-display text-4xl font-semibold text-gold-400">{num}</span>
          <h3 class="mt-3 font-display text-xl font-semibold text-ink-900">{title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-900/65">{desc}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- LOCAL AREA -->
  <section class="border-t border-ink-900/10 bg-white py-20">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
        <div>
          <span class="text-xs font-semibold uppercase tracking-[0.14em] text-gold-600">Serving the Wirral</span>
          <h2 class="mt-3 font-display text-3xl font-semibold text-ink-900 sm:text-4xl">Based in Hoylake. Trusted across the Wirral.</h2>
          <p class="mt-4 text-base leading-relaxed text-ink-900/65">
            {site.name} welcomes clients from Hoylake, West Kirby, Moreton and across the Wirral peninsula,
            as well as Chester and Liverpool. The clinic is easy to reach and appointments are unhurried by design.
          </p>
          <a href="/contact/" class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-ink-900 hover:text-gold-600">
            Get directions &amp; contact details &rarr;
          </a>
        </div>
        <div class="flex flex-wrap gap-3">
          {site.areaServed.map((area) => (
            <span class="rounded-full border border-ink-900/10 bg-porcelain-50 px-4 py-2 text-sm font-medium text-ink-900/70">{area}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="mx-auto max-w-4xl px-5 py-20 sm:px-8">
    <div class="text-center">
      <span class="text-xs font-semibold uppercase tracking-[0.14em] text-gold-600">Questions</span>
      <h2 class="mt-3 font-display text-3xl font-semibold text-ink-900 sm:text-4xl">Common questions</h2>
    </div>
    <div class="mt-10">
      <FaqAccordion faqs={featured} />
    </div>
    <p class="mt-6 text-center text-sm text-ink-900/60">
      <a href="/faqs/" class="font-semibold text-ink-900 hover:text-gold-600">Read the full FAQ &rarr;</a>
    </p>
  </section>

  <CtaBand />
</Layout>
