---
import Layout from '@/layouts/Layout.astro';
import TreatmentCard from '@/components/TreatmentCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import { treatments } from '@/data/treatments';
import { breadcrumbSchema } from '@/data/schema';

const categories = [...new Set(treatments.map((t) => t.category))];
---

<Layout
  title="Treatments | Maison Aurelia Aesthetics Clinic, Hoylake"
  description="Explore every treatment offered at Maison Aurelia in Hoylake, Wirral — dermal fillers, skin boosters, polynucleotides, biostimulators, anti-wrinkle treatment, fat dissolving, LED and micro-needling."
  path="/treatments/"
  schema={[breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Treatments', path: '/treatments/' }])]}
>
  <section class="mx-auto max-w-7xl px-5 py-16 sm:px-8 sm:py-24">
    <div class="max-w-2xl" data-reveal>
      <span class="text-xs font-semibold uppercase tracking-[0.14em] text-aurelia-600">Treatment menu</span>
      <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight text-emerald-900 sm:text-5xl">
        Every treatment we offer, explained properly.
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-emerald-900/65">
        No jargon, no guesswork. Each page below covers what a treatment actually does, who it suits,
        what to expect and how it's delivered — always following a full consultation with Jo.
      </p>
    </div>

    {categories.map((category) => (
      <div class="mt-16">
        <h2 class="font-display text-2xl font-semibold text-emerald-900" data-reveal>{category}</h2>
        <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-reveal="stagger">
          {treatments.filter((t) => t.category === category).map((t) => <TreatmentCard treatment={t} />)}
        </div>
      </div>
    ))}
  </section>

  <CtaBand />
</Layout>
