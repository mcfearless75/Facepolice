---
import Layout from '@/layouts/Layout.astro';
---

<Layout
  title="Page Not Found | Maison Aurelia"
  description="This page could not be found."
  path="/404/"
  noindex
>
  <section class="mx-auto flex min-h-[60vh] max-w-2xl flex-col items-center justify-center px-5 text-center sm:px-8">
    <p class="font-display text-6xl font-semibold text-emerald-900">404</p>
    <h1 class="mt-4 font-display text-2xl font-semibold text-emerald-900">We couldn't find that page.</h1>
    <p class="mt-3 text-emerald-900/65">It may have moved — try one of these instead.</p>
    <div class="mt-8 flex gap-3">
      <a href="/" class="rounded-full bg-emerald-900 px-6 py-3 text-sm font-semibold text-ivory-50 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg">Back home</a>
      <a href="/treatments/" class="rounded-full border border-emerald-900/15 px-6 py-3 text-sm font-semibold text-emerald-900 transition-all duration-300 hover:-translate-y-0.5 hover:border-emerald-900/40">View treatments</a>
    </div>
  </section>
</Layout>
