---
import Layout from '@/layouts/Layout.astro';
---

<Layout
  title="Page Not Found | Face Crease Police®"
  description="This page could not be found."
  path="/404/"
  noindex
>
  <section class="mx-auto flex min-h-[60vh] max-w-2xl flex-col items-center justify-center px-5 text-center sm:px-8">
    <p class="font-display text-6xl font-semibold text-ink-900">404</p>
    <h1 class="mt-4 font-display text-2xl font-semibold text-ink-900">We couldn't find that page.</h1>
    <p class="mt-3 text-ink-900/65">It may have moved — try one of these instead.</p>
    <div class="mt-8 flex gap-3">
      <a href="/" class="rounded-full bg-ink-900 px-6 py-3 text-sm font-semibold text-porcelain-50">Back home</a>
      <a href="/treatments/" class="rounded-full border border-ink-900/15 px-6 py-3 text-sm font-semibold text-ink-900">View treatments</a>
    </div>
  </section>
</Layout>
