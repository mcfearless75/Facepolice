---
import Layout from '@/layouts/Layout.astro';
import CtaBand from '@/components/CtaBand.astro';
import { goals } from '@/data/goals';
import { resultImages } from '@/data/results';
import { breadcrumbSchema } from '@/data/schema';
---

<Layout
  title="Client Results | Face Crease Police® Hoylake"
  description="Real client before-and-after results from Face Crease Police in Hoylake, Wirral — honest, consultation-led outcomes rather than exaggerated claims."
  path="/results/"
  schema={[breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Results', path: '/results/' }])]}
>
  <section class="mx-auto max-w-4xl px-5 py-16 sm:px-8 sm:py-24" data-reveal>
    <span class="text-xs font-semibold uppercase tracking-[0.14em] text-gold-600">Results</span>
    <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight text-ink-900 sm:text-5xl">
      Honest outcomes, not filtered photos.
    </h1>
    <p class="mt-6 text-lg leading-relaxed text-ink-900/70">
      Real clients, unretouched, photographed in clinic before and after treatment. Every face responds
      differently — these are shown as a guide to what's realistically achievable, not a promise.
    </p>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-16 sm:px-8">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-reveal="stagger">
      {resultImages.map((img) => (
        <figure class="group overflow-hidden rounded-2xl border border-ink-900/10 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-soft">
          <div class="overflow-hidden">
            <img src={img.src} alt={img.alt} width="1100" height="620" class="aspect-[16/9] w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105" loading="lazy" />
          </div>
          <figcaption class="border-t border-ink-900/10 px-4 py-3 text-xs font-semibold uppercase tracking-[0.1em] text-ink-900/50">
            {img.category}
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-16 sm:px-8">
    <h2 class="font-display text-2xl font-semibold text-ink-900" data-reveal>What each goal realistically delivers</h2>
    <div class="mt-6 grid gap-6 md:grid-cols-2" data-reveal="stagger">
      {goals.map((goal) => (
        <div class="rounded-2xl border border-ink-900/10 bg-white p-7 transition-all duration-300 hover:-translate-y-1 hover:shadow-soft">
          <h3 class="font-display text-2xl font-semibold text-ink-900">{goal.name}</h3>
          <p class="mt-2 text-sm font-semibold text-gold-600">{goal.strapline}</p>
          <p class="mt-4 text-sm leading-relaxed text-ink-900/70">{goal.description}</p>
          <a href={`/goals/${goal.slug}/`} class="nav-underline mt-4 inline-block pb-0.5 text-sm font-semibold text-ink-900">
            See {goal.name} treatments &rarr;
          </a>
        </div>
      ))}
    </div>
  </section>

  <section class="border-t border-ink-900/10 bg-porcelain-100/60 py-16">
    <div class="mx-auto max-w-3xl px-5 text-center sm:px-8" data-reveal>
      <h2 class="font-display text-2xl font-semibold text-ink-900">A note on results</h2>
      <p class="mt-4 text-sm leading-relaxed text-ink-900/65">
        Every face responds differently, and results depend on your anatomy, skin condition and the treatment
        agreed at consultation. We don't promise a specific outcome before assessing you in person — anyone who
        does should be questioned, not trusted.
      </p>
    </div>
  </section>

  <CtaBand />
</Layout>
