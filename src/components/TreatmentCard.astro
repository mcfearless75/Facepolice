---
import type { Treatment } from '@/data/treatments';
interface Props {
  treatment: Treatment;
}
const { treatment } = Astro.props;
---

<a
  href={`/treatments/${treatment.slug}/`}
  class="group flex flex-col justify-between rounded-2xl border border-ink-900/10 bg-white p-6 shadow-sm transition-all duration-300 ease-out hover:-translate-y-1.5 hover:border-gold-400/40 hover:shadow-soft"
>
  <div>
    <span class="text-[11px] font-semibold uppercase tracking-[0.14em] text-gold-600">{treatment.category}</span>
    <h3 class="mt-2 font-display text-xl font-semibold text-ink-900">{treatment.name}</h3>
    <p class="mt-2 text-sm leading-relaxed text-ink-900/65">{treatment.summary}</p>
  </div>
  <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-ink-900">
    Learn more
    <svg class="h-3.5 w-3.5 transition group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
      <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </span>
</a>
