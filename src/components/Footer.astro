---
import { site, primaryNav } from '@/data/site';
import { treatments } from '@/data/treatments';
import Logomark from '@/components/Logomark.astro';

const year = new Date().getFullYear();
---

<footer class="bg-ink-950 text-porcelain-100">
  <div class="mx-auto grid max-w-7xl gap-10 px-5 py-16 sm:px-8 md:grid-cols-4">
    <div class="md:col-span-1">
      <a href="/" class="flex items-center gap-3">
        <Logomark class="h-9 w-9" />
        <span class="font-display text-lg font-semibold text-porcelain-50">{site.name}</span>
      </a>
      <p class="mt-4 text-sm leading-relaxed text-porcelain-100/70">
        Medically-led facial aesthetics in Hoylake, Wirral. Every treatment is assessed and delivered
        by {site.practitioner.name}, an {site.practitioner.role}.
      </p>
      <div class="mt-5 flex gap-3">
        {site.social.facebook && (
          <a href={site.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook"
            class="grid h-9 w-9 place-items-center rounded-full border border-white/15 transition hover:border-gold-400 hover:text-gold-400">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 9H16V6h-2.5C11.6 6 10 7.6 10 9.9V12H8v3h2v7h3v-7h2.4l.6-3H13v-1.7c0-.8.2-1.3 1.5-1.3Z"/></svg>
          </a>
        )}
        {site.social.tiktok && (
          <a href={site.social.tiktok} target="_blank" rel="noopener noreferrer" aria-label="TikTok"
            class="grid h-9 w-9 place-items-center rounded-full border border-white/15 transition hover:border-gold-400 hover:text-gold-400">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M16.5 3c.4 2.2 2 3.8 4.2 4v3c-1.5 0-2.9-.4-4.2-1.3v6.7a6 6 0 1 1-6-6c.3 0 .7 0 1 .1v3.1a3 3 0 1 0 2 2.8V3h3Z"/></svg>
          </a>
        )}
      </div>
    </div>

    <div>
      <h3 class="text-xs font-semibold uppercase tracking-[0.18em] text-porcelain-100/50">Explore</h3>
      <ul class="mt-4 space-y-2.5 text-sm text-porcelain-100/80">
        {primaryNav.map((link) => (
          <li><a href={link.href} class="hover:text-gold-400">{link.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="text-xs font-semibold uppercase tracking-[0.18em] text-porcelain-100/50">Treatments</h3>
      <ul class="mt-4 space-y-2.5 text-sm text-porcelain-100/80">
        {treatments.slice(0, 6).map((t) => (
          <li><a href={`/treatments/${t.slug}/`} class="hover:text-gold-400">{t.shortName}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="text-xs font-semibold uppercase tracking-[0.18em] text-porcelain-100/50">Get in touch</h3>
      <ul class="mt-4 space-y-2.5 text-sm text-porcelain-100/80">
        <li>{site.addressLocality}, {site.addressRegion}</li>
        <li><a href={`mailto:${site.email}`} class="hover:text-gold-400">{site.email}</a></li>
        <li class="pt-2">
          <a href="/contact/" class="inline-flex rounded-full bg-porcelain-50 px-4 py-2 text-sm font-semibold text-ink-950 hover:bg-gold-400">
            Book a Consultation
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-7xl flex-col gap-2 px-5 py-6 text-xs text-porcelain-100/50 sm:flex-row sm:items-center sm:justify-between sm:px-8">
      <p>&copy; {year} {site.name} — a trade name of {site.legalName}. All rights reserved.</p>
      <div class="flex gap-4">
        <a href="/privacy-policy/" class="hover:text-gold-400">Privacy Policy</a>
        <a href="/faqs/" class="hover:text-gold-400">FAQs</a>
      </div>
    </div>
    <p class="mx-auto max-w-7xl px-5 pb-8 text-[11px] leading-relaxed text-porcelain-100/40 sm:px-8">
      Results vary between individuals. Anti-wrinkle treatment is a prescription-only medicine and is only
      prescribed following a face-to-face consultation with a qualified independent prescriber. This website
      does not advertise prices or offers for prescription-only medicines, in line with UK advertising
      standards for medical treatments.
    </p>
  </div>
</footer>
