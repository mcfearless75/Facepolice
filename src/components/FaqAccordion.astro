---
interface Props {
  faqs: { q: string; a: string }[];
}
const { faqs } = Astro.props;
---

<div class="divide-y divide-ink-900/10 rounded-2xl border border-ink-900/10 bg-white">
  {faqs.map((faq, i) => (
    <details class="group p-5 sm:p-6" name={`faq-${i}`} open={i === 0}>
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-base font-semibold text-ink-900 sm:text-lg">
        {faq.q}
        <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full border border-ink-900/15 text-ink-900/60 transition group-open:rotate-45">
          <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M12 5v14M5 12h14" stroke-linecap="round" />
          </svg>
        </span>
      </summary>
      <p class="mt-3 text-sm leading-relaxed text-ink-900/70 sm:text-base">{faq.a}</p>
    </details>
  ))}
</div>
